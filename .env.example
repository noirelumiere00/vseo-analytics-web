# ===========================================
# VSEO Analytics Web — 環境変数テンプレート
# .env にコピーして値を設定してください
# ===========================================

# Server
PORT=3001
HOST=0.0.0.0

# Database (MySQL)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/vseo

# JWT — openssl rand -base64 64 で生成した暗号的に安全な値を使用
JWT_SECRET=

# App URL
APP_URL=https://your-domain.com
OAUTH_SERVER_URL=https://your-domain.com

# Vite (client-side — VITE_ prefix = publicly visible)
VITE_ANALYTICS_ENDPOINT=https://your-domain.com
VITE_ANALYTICS_WEBSITE_ID=
VITE_OAUTH_PORTAL_URL=https://your-domain.com
VITE_APP_ID=vseo-analytics
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# Admin
ADMIN_NAME=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# Unlimited plan domains (comma-separated)
UNLIMITED_DOMAINS=

# Amazon Bedrock LLM (prefer EC2 IAM Role over access keys)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_ACCESS_KEY_ID=    # Use IAM Role instead
# AWS_SECRET_ACCESS_KEY= # Use IAM Role instead

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Apify (Instagram/TikTok scraping fallback)
APIFY_API_TOKEN=

# YouTube Data API v3 (set IP restriction in Google Cloud Console)
YOUTUBE_API_KEY=

# Instagram (session-only — DO NOT store passwords here)
INSTAGRAM_SESSION_ID=

# Bright Data Proxy (optional)
# PROXY_SERVER=
# PROXY_KYC_VERIFIED=false

# Stripe (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
